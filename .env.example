# Пример для docker-compose.yml. Скопируйте в .env и заполните.
# .env в git не коммитится — настоящие пароли храните только там.
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Для Gmail — пароль приложения (App Password), не пароль от аккаунта.
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=BPMN Testing System
MAIL_ENCRYPTION=starttls
