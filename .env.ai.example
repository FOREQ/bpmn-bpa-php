# Подключение ИИ (проверка практики и генерация заданий).
# Скопируйте нужные строки в .env (файл .env в git не попадает).
# Без этих переменных портал работает как раньше, ИИ-кнопки просто неактивны.

# Формат API: openai (любой OpenAI-совместимый /chat/completions) или anthropic
AI_API_STYLE=openai
# Адрес API без /chat/completions, например https://ai.example.kz/v1
AI_BASE_URL=
# Ключ доступа (для локальных моделей без авторизации можно оставить пустым)
AI_API_KEY=
# Имя модели, как его ожидает ваш сервер
AI_MODEL=

# Необязательно: отдельные ключи/модели для разных задач.
# Если не заданы, используются общие AI_* выше.
# AI_GRADER_API_KEY=
# AI_GRADER_MODEL=
# AI_GENERATOR_API_KEY=
# AI_GENERATOR_MODEL=

# Необязательные настройки
# AI_TIMEOUT=120               # секунд на один запрос (генератор по умолчанию 300, проверка 240)
# AI_JSON_MODE=0               # 1 — если сервер поддерживает response_format=json_object

# Лимит ответа в токенах. Больше 20000 не ставится: длинные ответы тормозят общий GPU.
# AI_GENERATOR_MAX_TOKENS=16000
# AI_GRADER_MAX_TOKENS=8000
# AI_MAX_TOKENS=4000           # для остальных вызовов

# Режим рассуждений (Qwen3 и т.п.) через chat_template_kwargs.enable_thinking.
# 0 — выключен (по умолчанию): иначе модель тратит лимит на рассуждения и ответ приходит пустым.
# AI_GENERATOR_THINKING=0
# AI_GRADER_THINKING=0
# AI_NO_TEMPLATE_KWARGS=0      # 1 — не отправлять chat_template_kwargs (если API их не принимает)

# Очередь запросов: не больше AI_MAX_PARALLEL одновременных запросов со всего портала
# (у ключа LiteLLM лимит 2 параллельных, третий получает 429).
# AI_MAX_PARALLEL=2
# AI_QUEUE_WAIT=60             # сколько секунд ждать свободного места, потом «ИИ занят»
# AI_RETRY_429=3               # повторов при 429 с нарастающей паузой
# AI_SLOTS_DIR=/tmp/bpmn_ai_slots
# AI_GRADER_TEMPERATURE=0.1
# AI_GENERATOR_TEMPERATURE=0.7

# Сервисы для схем (задание 3 и эталоны к заданиям 1–2)
# BPMN-Calculator (бэкенд FastAPI): показатели сложности и структурные замечания
CALCULATOR_URL=
# cct-mcp из try_yernaz: проверка IR и сборка .bpmn с раскладкой
CCT_MCP_URL=
CCT_MCP_TOKEN=
