# Пример для docker-compose.dtc.yml. Скопируйте в .env.dtc и заполните.
# .env.dtc в git не коммитится.
DB_DRIVER=pgsql
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Файл с учётными данными почты (JSON, см. .mail-credentials.example.json).
# По умолчанию docker-compose.dtc.yml берёт ./secrets/ews.json рядом с проектом
# (папка secrets/ в git не попадает). Свой путь задайте здесь и запускайте
# docker compose --env-file .env.dtc -f docker-compose.dtc.yml up -d,
# иначе compose не увидит переменную при подстановке пути:
# BPMN_MAIL_CREDENTIALS_PATH=/etc/bpmn/ews.json

# Обратный прокси перед порталом (через запятую, можно CIDR). Без этого лимит
# записи на курс считается по адресу прокси, а не посетителя.
# Передаётся в контейнер через env_file.
# TRUSTED_PROXIES=172.16.0.0/12
